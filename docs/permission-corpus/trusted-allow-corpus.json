   "family": "trusted-allow",
   "class": "UNKNOWN_REQUIRES_REVIEW",
   "expect": "ask",
   "cmd": "python3 /Users/bryant/.claude/bin/owner-merge-runner --repo Chisanan232/zz-nonexistent-probe-repo --pr 7 --expect-head 0123456789abcdef0123456789abcdef01234567 --review-evidence /nonexistent/zz-evidence.json --dry-run",
   "note": "a python3 prefix does not match the allow form: measured residual"
