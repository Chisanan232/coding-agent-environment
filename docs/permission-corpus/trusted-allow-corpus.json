{
 "version": 1,
 "description": "Trusted ALLOW corpus (SPE-118): the runner's literal allow form must run with no prompt (T01, T05), every direct or chained merge must prompt (T02-T04); UNKNOWN_REQUIRES_REVIEW entries are measured residuals that do not score. Owner home path /Users/bryant. Run with scripts/permission-host-matrix.py --candidate <scratch settings containing the live permissions plus the runner allow rule>. Probes use a nonexistent repository and a --dry-run runner, never a real PR.",
 "commands": [
  {
   "id": "T01-runner-literal",
   "family": "trusted-allow",
   "class": "AUTO_SAFE",
   "expect": "allow",
   "cmd": "/Users/bryant/.claude/bin/owner-merge-runner --repo Chisanan232/zz-nonexistent-probe-repo --pr 7 --expect-head 0123456789abcdef0123456789abcdef01234567 --review-evidence /nonexistent/zz-evidence.json --dry-run",
   "note": "the one allowed runner form (dry-run, nonexistent repo and evidence)"
  },
  {
   "id": "T02-runner-then-direct-merge",
