#!/usr/bin/env python3
"""Hold an opted-in managed resource through the pinned Glomeris core."""
import json
import os
from pathlib import Path
import selectors
import shlex
import subprocess
import sys
import time

RENEW_INTERVAL = 20
BUSY_RETRY_WINDOW = 2
BUSY_RETRY_INITIAL_DELAY = 0.1


def failed(reply):
    return not isinstance(reply, dict) or reply.get("status") != "ok"


def refuse(message):
    print(f"coding-agent-resource: {message}", file=sys.stderr)
    raise SystemExit(2)


def storage_binary(host):
    home = Path.home()
    skill = home / (".claude" if host == "claude" else ".codex") / "skills/engineering-runtime/scripts"
    bootstrap = skill / "bootstrap.py"
    if not bootstrap.is_file():
        refuse(f"{host} engineering-runtime bootstrap is unavailable")
    try:
        result = subprocess.run([sys.executable, str(bootstrap)], check=True,
                                text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        exports = {}
        for line in result.stdout.splitlines():
            fields = shlex.split(line)
            if len(fields) == 2 and fields[0] == "export" and "=" in fields[1]:
                key, value = fields[1].split("=", 1)
                exports[key] = value
    except (OSError, subprocess.SubprocessError, ValueError):
        refuse("engineering-runtime bootstrap failed")
    binary = exports.get("ENGINEERING_STORAGE_BIN", "")
    if exports.get("ENGINEERING_STORAGE_STATUS") != "verified_installation" or not binary:
        refuse("pinned Glomeris installation is not verified")
    return binary


class Core:
    def __init__(self, binary, resource_id, generation, host, session, owner_pid):
        try:
            self.process = subprocess.Popen(
                [binary, "resource", "hold", resource_id, generation, "--host", host,
                 "--session", session, "--owner-pid", str(owner_pid)],
                stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)
            os.set_blocking(self.process.stdout.fileno(), False)
            self.selector = selectors.DefaultSelector()
            self.selector.register(self.process.stdout, selectors.EVENT_READ)
            self.pending = bytearray()
            self.broken = False
        except OSError:
            refuse("could not start verified Glomeris core")

    def request(self, value, timeout=5):
        if self.broken or self.process.poll() is not None:
            self.broken = True
            return None
        try:
            self.process.stdin.write((json.dumps(value, separators=(",", ":")) + "\n").encode())
            self.process.stdin.flush()
        except (BrokenPipeError, OSError, ValueError, json.JSONDecodeError):
            self.broken = True
            return None
        return self.read_reply(timeout)

    def read_reply(self, timeout=5):
        if self.broken:
            return None
        deadline = time.monotonic() + timeout
        try:
            while time.monotonic() < deadline:
                if b"\n" in self.pending:
                    line, _, rest = self.pending.partition(b"\n")
                    self.pending = bytearray(rest)
                    reply = json.loads(line)
                    if isinstance(reply, dict) and isinstance(reply.get("status"), str):
                        return reply
                    self.broken = True
                    return None
                events = self.selector.select(max(0, deadline - time.monotonic()))
                if not events:
                    self.broken = True
                    return None
                chunk = os.read(self.process.stdout.fileno(), 65536)
                if not chunk:
                    self.broken = True
                    return None
                self.pending.extend(chunk)
            self.broken = True
        except (OSError, ValueError, json.JSONDecodeError):
            self.broken = True
        return None

    def close(self):
        if self.process.poll() is None:
            try:
                self.process.stdin.close()
            except OSError:
                pass
            try:
                self.process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass


def renew(core):
    request = {"op": "renew"}
    reply = core.request(request)
    if not isinstance(reply, dict) or reply.get("status") != "busy":
        return reply
    deadline = time.monotonic() + BUSY_RETRY_WINDOW
    delay = BUSY_RETRY_INITIAL_DELAY
    while time.monotonic() < deadline:
        remaining = deadline - time.monotonic()
        time.sleep(min(delay, remaining))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        reply = core.request(request, timeout=remaining)
        if not isinstance(reply, dict) or reply.get("status") != "busy":
            return reply
        delay = min(delay * 2, 0.5)
    return reply

def main(argv):
    if len(argv) < 4 or argv[0] != "--host" or argv[1] not in ("claude", "codex") or argv[2] != "--":
        refuse("usage: coding-agent-resource --host claude|codex -- COMMAND [ARG ...]")
    host, command = argv[1], argv[3:]
    if not command:
        refuse("native command is missing")
    resource_id = os.environ.get("CODING_AGENT_MANAGED_RESOURCE_ID", "")
    generation = os.environ.get("CODING_AGENT_MANAGED_RESOURCE_GENERATION", "")
    session = (os.environ.get("CODING_AGENT_RESOURCE_SESSION_ID") or
               os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID") or "")
    if not resource_id or not generation:
        refuse("managed resource ID and generation must both be set")
    if not session:
        refuse("managed mode requires an existing session identity")
    core = Core(storage_binary(host), resource_id, generation, host, session, os.getpid())
    held = core.read_reply()
    if (not held or held.get("status") != "held" or held.get("id") != resource_id
            or held.get("generation") != generation or not isinstance(held.get("path"), str)
            or not Path(held["path"]).is_absolute()):
        core.close()
        refuse("Glomeris did not confirm the requested persisted resource hold")
    resource_dir = held["path"]
    if failed(core.request({"op": "child_pending"})):
        core.close()
        refuse("Glomeris did not acknowledge pending child scope")
    child_env = os.environ.copy()
    child_env["GLOMERIS_RESOURCE_DIR"] = resource_dir
    try:
        child = subprocess.Popen(command, env=child_env, start_new_session=True)
    except OSError:
        core.close()
        refuse("native process could not be started")
    registered = core.request({"op": "register_child", "pid": child.pid, "pgid": child.pid})
    scope_confirmed = not failed(registered)
    if child.poll() is not None:
        scope_confirmed = False
        print("coding-agent-resource: child exited before registration was confirmed; preserving resource hold", file=sys.stderr)
    if not scope_confirmed:
        if child.poll() is None:
            print("coding-agent-resource: child registration unconfirmed; preserving child and resource hold", file=sys.stderr)
    next_renew = time.monotonic() + RENEW_INTERVAL
    while child.poll() is None:
        wait = max(0.05, min(1.0, next_renew - time.monotonic()))
        try:
            child.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            pass
        if child.poll() is None and time.monotonic() >= next_renew:
            if failed(renew(core)):
                print("coding-agent-resource: renewal unconfirmed; child continues under persisted hold", file=sys.stderr)
                scope_confirmed = False
            next_renew = time.monotonic() + RENEW_INTERVAL
    code = child.wait()
    if scope_confirmed and failed(core.request({"op": "release"})):
        print("coding-agent-resource: release unconfirmed; preserving resource hold for core reconciliation", file=sys.stderr)
    core.close()
    return code if code >= 0 else 128 - code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
