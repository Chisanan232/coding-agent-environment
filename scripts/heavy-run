#!/usr/bin/env python3
"""Class-declaring, queue-aware wrapper for one heavy command (ADR 0017).

Usage: heavy-run --label L --class C --bytes N [--ttl-s S] [--max-wait-s W] [--ticket T] [--repo R] -- COMMAND [ARG...]

Runs COMMAND as the lane holder of the shared heavy-job queue (scripts/disk-admission.py next to this file, so the runner is always
the checkout's own version). A free lane runs it at once; when the runner refuses (no lane, or entries already wait: "queue-ahead")
the job is enqueued with the same declared class and argv, advanced and polled until granted, then claimed with `run --queue-id`.
The lane is released when COMMAND exits. The command is never started outside a lane.

--class declares the workload (build-workspace for a Cargo workspace gate). Without it the runner records no class and charges the
reservation as an unknown workload (the host's whole resource budget), which is the conservative accounting and blocks every other
lane, so a missing class is warned about, not guessed.

When the entry's backfilled grant is revoked at claim or lapses unclaimed (SPE-176), the same job is re-queued at its original FIFO
position (`queue enqueue --requeue-of`) and the wait goes on, at most REQUEUE_MAX times; any other EXPIRED entry is refused as before.

Exit codes: COMMAND's own (a signal death is 128+N); 64 usage; 75 not admitted within --max-wait-s; 77 refused by the queue. A
command's own 64, 75 or 77 is indistinguishable from the wrapper's, as with la-cargo. A command already inside a lane
(CAE_ADMISSION_HOLDER names this process or an ancestor) is not charged again; that marker is trusted as the environment's word, so
it guards against double charging by accident, not against a caller who sets it on purpose.
"""
import argparse
from importlib.util import module_from_spec, spec_from_file_location
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

RUNNER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "disk-admission.py")
RECOVERY_LIB = os.path.join(os.path.dirname(RUNNER), "admission-recovery.py")
HOLDER_ENV = "CAE_ADMISSION_HOLDER"          # "<label>:<pid>", exported by the runner's run / queue claim
REFUSED_EXIT = 77
TIMEOUT_EXIT = 75
POLL_S = 15
NOTICE_EVERY_S = 300
# A backfilled grant revoked at claim, or lapsed unclaimed, is re-queued at its own FIFO position at most this many times (the runner's
# BACKFILL_REQUEUE_MAX caps the chain too). One poll iteration stays well under the runner's 600 s backfill claim window: the 15 s sleep,
# advance and status capped at 120 s each, and a refused claim bounded by the runner's own memory-gate (120 s) and lock (5 s) timeouts.
REQUEUE_MAX = 3


def exit_code(rc):
    """A command killed by a signal comes back from subprocess as -N; report it as a shell would (128+N), not as 256-N."""
    return 128 - rc if rc < 0 else rc


def runner_cmd(*args):
    return [sys.executable, RUNNER, *args]


def _capture(cmd, env):
    try:
        done = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=120, stdin=subprocess.DEVNULL)
        return done.returncode, done.stdout
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)


def _register(qid, kind):
    """Record this wrapper for the monitor's guarded recovery (ADR 0019). Best effort: any problem returns None and the job goes on."""
    try:
        spec = spec_from_file_location("admission_recovery", RECOVERY_LIB)
        lib = module_from_spec(spec)
        spec.loader.exec_module(lib)
        directory = lib.wrappers_dir()
        return (lib, directory) if lib.register_wrapper(directory, qid, kind) else None
    except (SystemExit, KeyboardInterrupt):
        raise      # a signal in this window keeps its meaning: the caller's `finally` still cancels or releases the entry
    except BaseException:
        return None


def _unregister(handle, qid):
    if handle:
        try:
            handle[0].unregister_wrapper(handle[1], qid)
        except (SystemExit, KeyboardInterrupt):
            raise
        except BaseException:
            pass


def _json(text):
    try:
        value = json.loads(text)
        return value if isinstance(value, dict) else {}
    except ValueError:
        return {}


def _ancestors():
    pids, pid = set(), os.getpid()
    for _ in range(64):
        out = subprocess.run(["/bin/ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True,
                             stdin=subprocess.DEVNULL).stdout.strip()
        if not out.isdigit() or int(out) <= 1:
            break
        pid = int(out)
        pids.add(pid)
    return pids


def inherited_holder(environ=None):
    """The runner's marker when this process already runs under a lane, else None. Accepted only when the marked pid is this
    process or an ancestor: a marker inherited by a process that outlived the job, or a forged one, proves nothing."""
    match = re.fullmatch(r"([A-Za-z0-9_][A-Za-z0-9._-]{0,63}):([0-9]+)", (os.environ if environ is None else environ).get(HOLDER_ENV, ""))
    if not match:
        return None
    pid = int(match.group(2))
    return match.group(0) if pid == os.getpid() or pid in _ancestors() else None


def _release(cmd, env):
    rc, out = _capture(runner_cmd(*cmd), env)
    if rc != 0 and " is RELEASED" not in out:       # the runner already released the entry when the job ended: nothing to do
        print(f"heavy-run: WARNING could not release the lane ({out.strip()[:200]}); run `disk-admission.py {' '.join(cmd)}` "
              "once the command has ended.", file=sys.stderr)


def admitted(args, env, sleep=time.sleep, clock=time.monotonic):
    label = args.label
    session = f"heavy-run-{os.getpid()}-{int(time.time())}"
    scratch = tempfile.mkdtemp(prefix="heavy-run-")
    proof = os.path.join(scratch, "started")
    # The job writes the proof then execs the command (same pid): the lane is held by the command itself, and "it ran" is
    # distinguishable from "the runner refused" even when the command's own exit code happens to be 77.
    job = ["/bin/sh", "-c", 'touch "$1" && shift && exec "$@"', "heavy-run", proof, *args.command]
    declare = ["--label", label, "--bytes", str(args.bytes)]
    if args.workload_class:
        declare += ["--class", args.workload_class]
    if args.no_cargo_target:
        declare += ["--no-cargo-target"]
    run_extra = ["--ttl-s", str(args.ttl_s)]
    try:
        rc = subprocess.call(runner_cmd("run", *declare, *run_extra, "--", *job), env=env)
        if os.path.exists(proof):
            _release(["release", "--label", label], env)
            return exit_code(rc)
        if rc != REFUSED_EXIT:
            print(f"heavy-run: the admission runner failed (exit {rc}) before starting the command; refusing (fail closed).", file=sys.stderr)
            return rc
        print("heavy-run: no heavy lane for this job right now; queueing for one.", file=sys.stderr)
        return _queued(args, declare, run_extra, job, proof, session, env, sleep, clock)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def _queued(args, declare, run_extra, job, proof, session, env, sleep, clock):
    ticket = re.sub(r"[^A-Za-z0-9._-]", "", args.ticket).lstrip("._-")[:32] or "heavy-run"
    worktree = os.getcwd()

    capable = runner_requeue_capable()

    def enqueue(wait_s, requeue_of=None):
        """(entry id or None, reason, runner reply). The same declaration, job and waiter every time, so a re-queue matches the lost
        entry."""
        # The capability goes on the first enqueue only: a replacement inherits it, and a re-queue must not depend on a flag the
        # runner (probed once, at start) might no longer accept after a checkout change during a long wait.
        extra = ["--requeue-of", requeue_of] if requeue_of else (["--requeue-capable"] if capable else [])
        rc, out = _capture(runner_cmd("queue", "enqueue", *declare, "--ticket", ticket, "--repo", args.repo, "--worktree", worktree,
                                      "--harness", args.harness, "--session-id", session, "--again", *extra, "--waiter-pid",
                                      str(os.getpid()), "--wait-s", str(max(wait_s, 60)), "--", *job), env)
        queued = _json(out)
        ok = rc == 0 and queued.get("ok") and queued.get("id")
        return (queued["id"] if ok else None), queued.get("reason", out.strip()[:200]), queued

    qid, why, _ = enqueue(args.max_wait_s)
    if not qid:
        print(f"heavy-run: could not queue the job: {why}", file=sys.stderr)
        return REFUSED_EXIT
    claimed, deadline, next_notice, registered, requeues = False, clock() + args.max_wait_s, 0.0, None, 0
    try:
        registered = _register(qid, "heavy-run")
        while clock() < deadline:
            _capture(runner_cmd("queue", "advance"), env)
            _, listing = _capture(runner_cmd("queue", "status", "--json"), env)
            entry = next((e for e in _json(listing).get("entries", []) if e.get("id") == qid), None)
            state = entry.get("state") if entry else None
            if state == "GRANTED":
                rc = subprocess.call(runner_cmd("run", *declare, *run_extra, "--queue-id", qid, "--", *job), env=env)
                if os.path.exists(proof):
                    claimed = True
                    _release(["queue", "release", "--id", qid, "--session-id", session], env)
                    return exit_code(rc)
                print(f"heavy-run: claim of {qid} refused (exit {rc}); the grant is kept, retrying.", file=sys.stderr)
            elif state == "EXPIRED" and requeues >= REQUEUE_MAX:
                print(f"heavy-run: queue entry {qid} is EXPIRED after {requeues} backfill re-queues (limit {REQUEUE_MAX}); refusing.",
                      file=sys.stderr)
                return REFUSED_EXIT
            elif state == "EXPIRED" and _replaces(requeued := enqueue(int(deadline - clock()), requeue_of=qid), qid):
                # The runner alone decides: it re-queues only an entry whose backfilled grant it revoked or saw lapse unclaimed. An
                # ordinary expiry is refused there and falls to the unchanged refusal below in this same pass.
                replacement = requeued[0]
                cause = "lapsed unclaimed" if requeued[2].get("evidence") == "backfill-lapsed" else "revoked"
                print(f"heavy-run: backfill grant {cause}; re-queued as {replacement} (was {qid}, original FIFO position kept).",
                      file=sys.stderr)
                _unregister(registered, qid)
                qid, requeues = replacement, requeues + 1
                registered = _register(qid, "heavy-run")
                continue
            elif state not in ("QUEUED", "ELIGIBLE"):
                print(f"heavy-run: queue entry {qid} is {state or 'missing'}; refusing.", file=sys.stderr)
                return REFUSED_EXIT
            elif clock() >= next_notice:
                print(f"heavy-run: waiting for a heavy lane ({qid} {state}).", file=sys.stderr)
                next_notice = clock() + NOTICE_EVERY_S
            sleep(POLL_S)
        print(f"heavy-run: not admitted within {args.max_wait_s} s; the command was NOT started.", file=sys.stderr)
        return TIMEOUT_EXIT
    finally:
        if not claimed and os.path.exists(proof):
            # interrupted after the claim started the job: the entry is CLAIMED, so it is released, not cancelled
            _release(["queue", "release", "--id", qid, "--session-id", session], env)
        elif not claimed:
            _capture(runner_cmd("queue", "cancel", "--id", qid, "--session-id", session), env)
        _unregister(registered, qid)      # last: a registry problem can never skip the cancel or release above


def runner_requeue_capable():
    """True when RUNNER accepts --requeue-capable (and so --requeue-of): this wrapper re-queues a lost backfilled grant, and the runner
    then lets the entry be backfilled (SPE-176). Read as text, never executed. A runner from an older revision lacks the flag, so it is
    not passed (no argparse refusal) and the entry is simply never backfilled."""
    try:
        with open(RUNNER, "rb") as handle:
            return b"'--requeue-capable'" in handle.read(4 * 2**20)
    except OSError:
        return False


def _replaces(requeued, qid):
    """True only for the runner's replacement of qid: an id plus requeue_of naming qid. Any other reply, an `existing` entry that is not
    qid's replacement included, is a refusal, so the wrapper never adopts an entry another wrapper waits on."""
    return bool(requeued[0]) and requeued[2].get("requeue_of") == qid


def _terminate(signum, _frame):
    raise SystemExit(128 + signum)


def class_disk_floor(name):
    """Disk bytes the runner requires at least for a class (its table, loaded from the runner next to this file), or 0 when unknown."""
    try:
        spec = spec_from_file_location("disk_admission", RUNNER)
        module = module_from_spec(spec)
        spec.loader.exec_module(module)
        return int(module.WORKLOAD_CLASSES[name]["disk_gib"]) * 2**30
    except Exception:
        return 0


def classify_auto(command):
    """The step classifier next to this file (scripts/classify-step.py), loaded fresh so the checkout's own rules apply."""
    from importlib.util import module_from_spec, spec_from_file_location
    spec = spec_from_file_location("classify_step", os.path.join(os.path.dirname(os.path.realpath(__file__)), "classify-step.py"))
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.classify(command)


def parse(argv):
    parser = argparse.ArgumentParser(prog="heavy-run", add_help=True, allow_abbrev=False)
    parser.add_argument("--label", required=True, help="reservation label, [A-Za-z0-9_][A-Za-z0-9._-]{0,63}")
    parser.add_argument("--class", dest="workload_class", help="declared workload class (see disk-admission.py run --help), or 'auto' to let scripts/classify-step.py decide: "
                        "a light step runs at once outside any lane, a heavy one takes the class it names, an unrecognised one is refused (64)")
    parser.add_argument("--bytes", type=int, required=True, help="disk bytes to reserve (at least the class default)")
    parser.add_argument("--ttl-s", type=int, default=4 * 3600)
    parser.add_argument("--max-wait-s", type=int, default=3600)
    parser.add_argument("--cargo-target-dir", default="", help="the Cargo target directory this job really builds into (a script that exports "
                        "CARGO_TARGET_DIR itself hides it from the wrapper). Exported to the command and used for the exclusion key: jobs on the "
                        "same directory exclude each other, jobs on different directories do not")
    parser.add_argument("--no-cargo-target", action="store_true", help="the job runs no Cargo build (a pure-Python gate): no Cargo-target "
                        "exclusion; memory, CPU and disk are still charged")
    parser.add_argument("--ticket", default="")
    parser.add_argument("--repo", default="heavy-run")
    parser.add_argument("--harness", choices=("claude", "codex"), default=os.environ.get("HEAVY_RUN_HARNESS", "claude"))
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    if args.command[:1] == ["--"]:
        args.command = args.command[1:]
    if not args.command:
        parser.error("empty command: pass it after --")
    if not 1 <= args.ttl_s <= 14400:
        parser.error("--ttl-s must be 1..14400 (the runner refuses a longer hold without --max-hold)")
    return args


SHELL_BINARIES = {"bash", "sh", "zsh"}
CMD_START = r"(?:^|[;&|{(]|\bthen\b|\bdo\b)[ \t]*"
TARGET_ASSIGN = re.compile(r"""(?m)""" + CMD_START + r"""(?:export[ \t]+)?(?:[A-Za-z_]+=\S*[ \t]+)*CARGO_TARGET_DIR=("[^"\n]*"|'[^'\n]*'|[^\s;&|]+)""")
WORKSPACE_CARGO = re.compile(r"(?m)" + CMD_START + r"(?:(?:env|time|command|nohup)[ \t]+|[A-Za-z_]+=\S*[ \t]+)*cargo[ \t]+(?:(?:\+|-)\S*[ \t]+)*(?:build|b|test|t|nextest[ \t]+run|clippy|check|doc)\b[^\n|;&]*[ \t]--(?:workspace|all)(?![\w-])")
WORKSPACE_BYTES = 40 * 2**30
CLASS_ORDER = {"build-crate": 1, "build-workspace": 2}


def _script_text(command):
    """Text of the script in an exact `bash|sh|zsh SCRIPT [ARGS]` command, or the inline text of `bash|sh|zsh -c TEXT`, else None. Only
    the top-level text: a script it calls is not followed (the owner declares --cargo-target-dir for those). Backslash-newline joins."""
    if not command or os.path.basename(command[0]) not in SHELL_BINARIES or len(command) < 2:
        return None
    if command[1] == "-c":
        text = command[2] if len(command) > 2 else None
    elif command[1].startswith("-"):
        return None
    else:
        try:
            with open(command[1], "rb") as handle:
                text = handle.read(256 * 1024).decode("utf-8", "replace")
        except OSError:
            return None
    return text.replace("\\\n", " ") if text is not None else None


def prepare(args, env):
    """Make the admission key describe what the command will really use. Returns an error text (exit 64) or None; edits env in place.
    The runner derives its Cargo-target exclusion key from the environment this wrapper hands it (cargo's own resolution order), which
    cannot see a variable a script sets inside itself. So: an explicit --cargo-target-dir is exported to the command and the runner;
    a literal CARGO_TARGET_DIR in the script's own text must agree with it (or, with no declaration, is adopted); a script that builds
    a whole workspace may not be declared as a single-crate build."""
    declared = os.path.realpath(os.path.abspath(args.cargo_target_dir)) if args.cargo_target_dir else ""
    text = _script_text(args.command)
    if text is not None:
        literals = {m.group(1).strip("\"'") for m in TARGET_ASSIGN.finditer(text)}
        if any(not os.path.isabs(v) or "$" in v or "`" in v for v in literals):
            if not declared:
                return ("the script sets CARGO_TARGET_DIR from a variable, a `~` or a relative path, so the wrapper cannot tell which target it builds into; pass "
                        "--cargo-target-dir DIR (or --no-cargo-target for a job that runs no cargo)")
            literals = {v for v in literals if os.path.isabs(v) and "$" not in v and "`" not in v}
        resolved = {os.path.realpath(os.path.abspath(v)) for v in literals}
        if len(resolved) > 1:
            return f"the script sets CARGO_TARGET_DIR to {len(resolved)} different directories; one job uses one target (split it, or declare --cargo-target-dir)"
        if resolved and not declared and not args.no_cargo_target:
            declared = next(iter(resolved))
            print(f"heavy-run: the script sets CARGO_TARGET_DIR={declared}; using it as the exclusion key.", file=sys.stderr)
        elif resolved and declared and next(iter(resolved)) != declared:
            return f"--cargo-target-dir {declared} differs from the CARGO_TARGET_DIR {next(iter(resolved))} the script sets"
        if (args.workload_class or "") in CLASS_ORDER and CLASS_ORDER[args.workload_class] < 2 and WORKSPACE_CARGO.search(text):
            return ("the script builds or tests the whole cargo workspace (--workspace/--all): declare --class build-workspace with "
                    f"--bytes >= {WORKSPACE_BYTES}, not {args.workload_class}")
    if declared and args.no_cargo_target:
        return "--cargo-target-dir and --no-cargo-target contradict each other"
    if declared and args.cargo_target_dir:
        inline = text if text is not None else ""
        if any(a == "--target-dir" or a.startswith("--target-dir=") for a in args.command) or re.search(r"--target-dir\b", inline):
            return "the command or its script names its own --target-dir; use --cargo-target-dir for the key instead of both"
    if declared:
        env["CARGO_TARGET_DIR"] = declared
        env.pop("CARGO_BUILD_TARGET_DIR", None)
    return None


def main(argv=None, env=None):
    try:
        args = parse(sys.argv[1:] if argv is None else argv)
    except SystemExit as exc:
        return 64 if exc.code else 0
    env = dict(os.environ if env is None else env)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _terminate)
    holder = inherited_holder(env)
    if holder:
        print(f"heavy-run: already running under lane {holder}; not charged again.", file=sys.stderr)
        try:
            return exit_code(subprocess.call(args.command, env=env))
        except OSError as exc:
            print(f"heavy-run: cannot run {args.command[0]}: {exc}", file=sys.stderr)
            return 127
    if args.workload_class in (None, "auto"):
        # An omitted class is classified like `--class auto`; only a command the classifier cannot name stays classless (below).
        omitted = args.workload_class is None
        verdict = classify_auto(args.command)
        print(f"heavy-run: --class {'(omitted) ' if omitted else ''}auto: {verdict['weight']} ({verdict['class']}): {verdict['reason']}", file=sys.stderr)
        if verdict["weight"] == "unknown":
            if not omitted:
                print("heavy-run: refusing to guess; declare --class (docs/RESOURCE-ADMISSION.md, step classification) or run a light step directly.",
                      file=sys.stderr)
                return 64
            args.workload_class = None
        elif verdict["weight"] == "light":
            try:
                return exit_code(subprocess.call(args.command, env=env))
            except OSError as exc:
                print(f"heavy-run: cannot run {args.command[0]}: {exc}", file=sys.stderr)
                return 127
        else:
            args.workload_class = verdict["class"]
            floor = class_disk_floor(args.workload_class)
            if floor and args.bytes < floor:
                print(f"heavy-run: --bytes {args.bytes} raised to the {args.workload_class} default {floor} (an estimate can be raised, never lowered).",
                      file=sys.stderr)
                args.bytes = floor
            if verdict.get("cargo") is False and not args.cargo_target_dir:
                args.no_cargo_target = True
    error = prepare(args, env)
    if error:
        print(f"heavy-run: {error}", file=sys.stderr)
        return 64
    if not args.workload_class:
        print("heavy-run: WARNING no --class: the runner records an unknown workload and charges the host's whole resource budget.",
              file=sys.stderr)
    return admitted(args, env)


if __name__ == "__main__":
    sys.exit(main())
